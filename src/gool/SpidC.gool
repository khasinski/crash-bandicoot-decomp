    ;; --- state_9 trans ---
  (label loc_0222)
    (beqz (bit-test 4096 status-a) loc_0227)
    (push2 null 25600)
    (bit-test data[15] player.status-a)
    (send-event collider 768 1 tos)
  (label loc_0227)
    (move (add data[50] rot-y) rot-y)
    (ret)
    ;; --- state_10 code ---
  (label loc_022A)
    (move 256 status-b)
    (anim-seq 0x020 0 60 keep)
    (anim-seq 0x020 0 60 keep)
    (move 4096 scale-x)
    (move 4096 scale-y)
    (move 4096 scale-z)
    (move 0 rot-x)
    (move 0 rot-y)
    (move 0 rot-z)
    (path-follow trans target-rot 0)
    (change-state state_8)
    (ret)
    ;; --- state_11 code ---
  (label loc_0236)
    (load-anim 2560 anim-seq)
    (move fp[-3] field-8)
    (move 0 parent.reg-3c)
    (move fp[-2] field-9)
    (move fp[-1] field-10)
    (move (add field-8 parent.y) y)
  (label loc_023D)
    (move (bit-and data[54] parent.reg-3c) reg-3c)
    (beqz (gt 0 parent.scale-x) loc_0243)
    (anim-frame reg-3c 1 neg)
    (bra loc_0244)
  (label loc_0243)
    (anim-frame reg-3c 1 pos)
  (label loc_0244)
    (bra loc_023D)
    (ret)
    ;; --- state_11 trans ---
  (label loc_0246)
    (beqz (not (bit-test 32 status-a) tos) loc_0258)
    (move (add field-10 parent.cam-zoom) cam-zoom)
    (move parent.x x)
    (move parent.z z)
    (move (add 512 parent.rot-y) rot-y)
    (move (shl data[55] (mul field-9 parent.scale-x)) scale-x)
    (move (shl data[55] (mul field-9 parent.scale-y)) scale-y)
    (move (shl data[55] (mul field-9 parent.scale-z)) scale-z)
  (label loc_0258)
    (ret)
  )
)
